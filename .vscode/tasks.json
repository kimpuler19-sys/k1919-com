{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Local production build",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"npm.cmd",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Inspect Node processes",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"tasklist",
				"/FI",
				"IMAGENAME eq node.exe"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install locked dependencies",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"npm.cmd",
				"ci"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}